# ─────────────────────────────────────────────────────────────
# Vibe Mode — environment variables
# ─────────────────────────────────────────────────────────────
#
# The app runs with ZERO environment variables. Everything below is optional.
# Copy this file to `.env` (or set the vars in Netlify → Site settings →
# Environment variables) only if you want to override defaults.
#
# ⚠️  Vite exposes every VITE_* variable in the public JS bundle.
#     NEVER put a secret, private key, or service-account credential here.
# ─────────────────────────────────────────────────────────────

# Canonical site URL, used for Open Graph / canonical tags.
# Example: https://vibemode.netlify.app
VITE_SITE_URL=

# Optional per-mode YouTube playlist overrides.
# These win over the values in `src/music/playlists.ts`, which is handy when you
# want the same codebase to point at different playlists per deploy.
# A YouTube playlist ID is the `list=` part of a playlist URL and usually
# starts with "PL", "OLAK5uy_" or "RD".
VITE_PLAYLIST_JUDAAD_NIGHT=
VITE_PLAYLIST_JUDAAD_CHAI=
VITE_PLAYLIST_METRO_VIBES=
VITE_PLAYLIST_METRO_RUSH=
VITE_PLAYLIST_TRAIN_WINDOW=
VITE_PLAYLIST_TRAIN_NIGHT=
VITE_PLAYLIST_CAB_NIGHT=
VITE_PLAYLIST_CAB_RAIN=
VITE_PLAYLIST_OFFICE_FOCUS=
VITE_PLAYLIST_OFFICE_LUNCH=
