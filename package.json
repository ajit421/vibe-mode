{
  "name": "vibe-mode",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vibe Mode — pick where you are, get the world and the music that goes with it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "og": "node scripts/generate-og.mjs",
    "env-to-defaults": "node scripts/env-to-defaults.mjs",
    "db:migrate": "wrangler d1 migrations apply vibe-mode --remote",
    "preview:cf": "npm run build && wrangler d1 migrations apply vibe-mode --local && wrangler pages dev",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "deploy": "npm run build && wrangler pages deploy --branch main"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "motion": "^11.15.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@eslint/js": "^9.17.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  }
}
