# The service worker must never be cached, or a fixed one could take a day to
# reach visitors. (Browsers already revalidate it, but this makes it certain.)
/sw.js
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# The owner's page holds the owner key in its tab: only its own scripts and
# styles, requests only to its own API, pictures only as data URLs or from
# here, no form may post anywhere, and no other site may frame it. The one
# exception is Google's sign-in script, button frame and styles (/gsi/ only,
# as Google's CSP guide lists them) for "Continue with Google".
/admin
  Content-Security-Policy: default-src 'none'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' https://accounts.google.com/gsi/style; frame-src https://accounts.google.com/gsi/; img-src 'self' data:; connect-src 'self' https://accounts.google.com/gsi/; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Robots-Tag: noindex

# OAuth discovery (public/_redirects): readable by browser-based MCP clients.
/oauth/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/.well-known/*
  Access-Control-Allow-Origin: *
